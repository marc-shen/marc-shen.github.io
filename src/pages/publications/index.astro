---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PAGES } from "../../config";
import { getCollection } from "astro:content";

if (PAGES.publications.isActive === false) {
    return Astro.redirect("/404");
}

const publications = await getCollection("publications");
const groups = ["Published", "Submitted", "In preparation"] as const;
---

<BaseLayout
    title={PAGES.publications.title}
    description={PAGES.publications.subtitle}
>
    <div class="space-y-12 pb-12">
        <header class="border-b border-border pb-10">
            <p class="font-mono text-sm uppercase tracking-[0.2em] text-accent">
                Research output
            </p>
            <h1 class="mt-3 text-4xl font-semibold">
                {PAGES.publications.title}
            </h1>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-text-muted">
                {PAGES.publications.subtitle}
            </p>
        </header>

        {groups.map(status => (
            <section class="space-y-6">
                <h2 class="text-2xl font-semibold">{status}</h2>
                <div class="divide-y divide-border border-y border-border">
                    {publications
                        .filter(entry => entry.data.status === status)
                        .sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""))
                        .map(({ id, data }) => (
                            <article class="space-y-3 py-7">
                                <h3 class="text-lg font-semibold leading-7">
                                    <a href={`/publications/${id}`}>{data.title}</a>
                                </h3>
                                <p class="leading-7 text-text-muted">{data.author}</p>
                                {data.journal && <p class="text-sm">{data.journal} · {data.date?.slice(0, 4)}</p>}
                                {data.external_url && (
                                    <a href={data.external_url} class="inline-block text-sm font-medium">
                                        DOI: {data.external_url.replace("https://doi.org/", "")}
                                    </a>
                                )}
                            </article>
                        ))}
                </div>
            </section>
        ))}
    </div>
</BaseLayout>
