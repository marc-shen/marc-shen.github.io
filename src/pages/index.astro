---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const publishedPapers = (await getCollection("publications"))
    .filter(entry => entry.data.status === "Published")
    .sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""));

const researchAreas = [
    {
        number: "01",
        title: "Plasma Propagation Effects · EMPI",
        description:
            "I contribute to EMPI, a high-performance computing software package for simulating the interaction between electromagnetic waves and plasma, with an emphasis on wave-spreading phenomena.",
        href: "/projects/empi",
    },
    {
        number: "02",
        title: "Fast Radio Bursts · FAST",
        description:
            "Since April 2026, I have participated in the FAST FRB Key Science Project, studying fast radio bursts with the FAST radio telescope.",
        href: "/projects/fast-frb",
    },
    {
        number: "03",
        title: "Particle-in-Cell Plasma Simulations",
        description:
            "From 2023 to 2025, I used the tristan-mp-v2 particle-in-cell code to study radiation mechanisms in high-energy transient sources, focusing on shocks and magnetic reconnection.",
        href: "/projects/tristan-mp-v2",
    },
    {
        number: "04",
        title: "Gamma-Ray Burst Satellites · Tiange / GRID07",
        description:
            "From 2023 to 2025, I served as student leader for Beijing Normal University's GRID07 satellite in the Tiange program to observe gamma-ray bursts.",
        href: "/projects/tiange",
    },
    {
        number: "05",
        title: "Supernova Search · ZTF",
        description:
            "From 2021 to 2023, I searched and selected supernovae in Zwicky Transient Facility data to study specific core-collapse models as part of a Beijing Municipal Undergraduate Research Project.",
        href: "/projects/ztf-supernovae",
    },
];
---

<BaseLayout
    title="Home"
    description="Songyu Shen is an astronomy master's student at Beijing Normal University studying fast radio bursts and plasma propagation effects."
>
    <div class="space-y-20 pb-12">
        <section class="grid gap-10 pb-10 lg:grid-cols-[1fr_1.1fr] lg:items-center">
            <div class="space-y-7">
                <p class="font-mono text-sm uppercase tracking-[0.2em] text-accent">
                    Master's Student in Astronomy
                </p>
                <h1 class="max-w-3xl text-4xl font-semibold leading-tight sm:text-5xl">
                    Welcome to Songyu Shen's homepage.
                </h1>
                <p class="max-w-2xl text-lg leading-8 text-text-muted">
                    I am a master's student in Astronomy at Beijing Normal
                    University, advised by Prof. He Gao. I study fast radio
                    bursts and plasma propagation effects through numerical
                    simulations and high-performance computing.
                </p>
                <p class="max-w-2xl leading-7 text-text-muted">
                    I received my bachelor's degree in Astronomy from BNU in
                    2024 and expect to complete my master's degree in June 2027.
                </p>
                <div class="flex flex-wrap gap-4 pt-2">
                    <a
                        href="/projects"
                        class="rounded-md bg-accent px-5 py-3 text-sm font-medium text-white! no-underline transition-colors hover:bg-accent-strong hover:text-white!"
                    >
                        View Projects
                    </a>
                    <a
                        href="/cv"
                        class="rounded-md border border-border px-5 py-3 text-sm font-medium no-underline transition-colors hover:border-secondary hover:text-secondary"
                    >
                        View CV
                    </a>
                    <a href="/files/Songyu_Shen_CV.pdf" download data-astro-reload class="self-center text-sm font-medium">
                        Download CV (PDF)
                    </a>
                </div>
            </div>

            <figure class="research-visual">
                <img
                    src="/assets/images/EMPI.png"
                    alt="Parallel EMPI plasma interaction calculation"
                    width="1600"
                    height="900"
                    loading="eager"
                />
                <figcaption>Electromagnetic wave–plasma interaction calculation</figcaption>
            </figure>
        </section>

        <section class="space-y-8">
            <div class="flex items-end justify-between gap-6">
                <div>
                    <p class="font-mono text-sm uppercase tracking-[0.2em] text-accent">
                        Selected work
                    </p>
                    <h2 class="mt-2 text-2xl font-semibold">Research Topics</h2>
                </div>
                <a href="/projects" class="text-sm text-accent hover:underline">
                    All projects
                </a>
            </div>

            <div class="divide-y divide-border border-y border-border">
                {
                    researchAreas.map((item) => (
                        <article class="grid gap-3 py-7 sm:grid-cols-[3rem_1fr_auto] sm:items-start">
                            <span class="font-mono text-sm text-accent">
                                {item.number}
                            </span>
                            <div>
                                <h3 class="text-lg font-medium text-accent!">
                                    {item.title}
                                </h3>
                                <p class="mt-2 leading-7 text-text-muted">
                                    {item.description}
                                </p>
                            </div>
                            <a
                                href={item.href}
                                class="text-sm text-accent no-underline hover:underline"
                                aria-label={`Read more about ${item.title}`}
                            >
                                Read more
                            </a>
                        </article>
                    ))
                }
            </div>
        </section>

        <section class="grid gap-10 border-t border-border pt-14 lg:grid-cols-[1fr_1.1fr] lg:items-center">
            <div>
                <p class="font-mono text-sm uppercase tracking-[0.2em] text-accent">
                    Simulation
                </p>
                <h2 class="mt-3 text-2xl font-semibold">
                    Particle-in-cell simulation of magnetic reconnection
                </h2>
                <p class="mt-4 leading-7 text-text-muted">
                    A simulation from my work with the tristan-mp-v2 PIC code,
                    used to investigate magnetic reconnection and relativistic
                    collisionless shocks.
                </p>
            </div>
            <figure class="research-visual">
                <img
                    src="/assets/images/reconnection_animation.gif"
                    alt="Animation of a particle-in-cell magnetic reconnection simulation"
                    width="1800"
                    height="1400"
                    loading="lazy"
                />
                <figcaption>PIC magnetic reconnection simulation</figcaption>
            </figure>
        </section>

        <section class="space-y-8">
            <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                    <p class="font-mono text-sm uppercase tracking-[0.2em] text-accent">Research output</p>
                    <h2 class="mt-2 text-2xl font-semibold">Recent Publications</h2>
                </div>
                <a href="/publications" class="text-sm">All publications & manuscripts</a>
            </div>
            <div class="divide-y divide-border border-y border-border">
                {publishedPapers.map(({ id, data }) => (
                    <article class="space-y-3 py-7">
                        <p class="text-sm text-text-muted">{data.journal} · {data.date?.slice(0, 4)}</p>
                        <h3 class="text-lg font-medium leading-7">
                            <a href={`/publications/${id}`}>{data.title}</a>
                        </h3>
                        <p class="text-sm leading-6 text-text-muted">{data.author}</p>
                    </article>
                ))}
            </div>
        </section>

        <section class="grid gap-10 sm:grid-cols-2">
            <div class="space-y-4">
                <h2 class="text-2xl font-semibold">Teaching & Outreach</h2>
                <p class="leading-7 text-text-muted">
                    I have served as a teaching assistant for Introduction to
                    Astronomy II, Fundamentals of Linux Applications, and
                    Academic Presentation Skills, and participated in AstroLink
                    astronomy outreach for high school students.
                </p>
                <a href="/cv#teaching-and-outreach" class="inline-block text-sm">Teaching experience</a>
            </div>
            <div class="space-y-4">
                <h2 class="text-2xl font-semibold">Academic Activities</h2>
                <p class="leading-7 text-text-muted">
                    I have presented my work at COSPAR and the Shen Kuo
                    Conference, and served on local organizing committees for
                    the Shen Kuo Conference and the Symposium on Fast Radio
                    Bursts and Their Astrophysics.
                </p>
                <a href="/cv#conference-presentations" class="inline-block text-sm">Talks & academic service</a>
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .research-visual {
        overflow: hidden;
        margin: 0;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        background: var(--surface);
    }

    .research-visual img {
        display: block;
        width: 100%;
        height: auto;
    }

    .research-visual figcaption {
        padding: 0.75rem 1rem;
        color: var(--text-muted);
        font-size: 0.8rem;
        line-height: 1.5;
    }
</style>
